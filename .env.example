# Supabase project URL and publishable key (Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Must match your manually created Supabase Auth host user.
HOST_EMAIL=your-host-email@example.com

# Your production HTTPS origin, without a trailing slash. Used for site metadata.
SITE_URL=
